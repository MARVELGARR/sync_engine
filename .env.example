# ─── PostgreSQL ──────────────────────────────────────
POSTGRES_USER=sync_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sync_engine
DATABASE_URL=postgresql://sync_admin:changeme@postgres-db:5432/sync_engine

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://redis-broker:6379

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=your-super-secret-256-bit-key-change-this
JWT_EXPIRY=24h

# ─── CORS (user-service owns CORS; gateway just proxies) ──
# Comma-separated browser origins allowed to call /api.
CORS_ORIGINS=http://localhost,http://localhost:3000

# ─── Service URLs (internal Docker network) ─────────
USER_SERVICE_URL=http://user-service:3000

# ─── Sync Service ───────────────────────────────────
SYNC_SERVICE_PORT=4000
NODE_ID=sync-1

# ─── Persist Worker ─────────────────────────────────
FLUSH_INTERVAL_MS=5000
FLUSH_THRESHOLD=50

# ─── Frontend (Next.js, baked at build time) ──────────
# Browser-facing origin (via gateway :80 by default).
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/ws
# Host port mapped to frontend:3000 (direct debug access).
FRONTEND_PORT=3000
